# ---------------------------------------------------------------------------
# The Chai-Stall Terminal - environment template
#
# Copy this file to `.env.local` and fill in real values as needed.
# All VITE_* variables are PUBLIC: they are compiled into the client bundle.
# NEVER put private keys, seed phrases, or API keys in this file.
# ---------------------------------------------------------------------------

# Base Sepolia JSON-RPC endpoint. The default public endpoint below works
# without an API key. A dedicated endpoint is recommended for reliability
# (public endpoints are rate limited and may throttle mobile devices).
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org

# Address of the official reference prediction-market contract provided in the
# Road to Devcon 9 Problem 1 statement (The Chai-Stall Terminal).
#
# Leave empty if you do not have it. The app detects the empty value and shows
# an explicit "contract not configured" state instead of fabricating data.
# A public contract address is not a secret, but only fill this in once you
# have verified it against the problem statement.
VITE_REFERENCE_CONTRACT_ADDRESS=

# Optional. Block number at which the reference contract was deployed.
# Used to bound the address-filtered event-log fallback scan (positions) so
# the app never scans the whole chain. Leave empty to use a bounded recent
# window (see MAX_LOG_LOOKBACK_BLOCKS in src/config/chain.ts).
VITE_CONTRACT_DEPLOYMENT_BLOCK=
